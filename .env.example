# Exemplo. Copie para .env e preencha os valores antes de usar Docker.
POSTGRES_DB=geracao_livre_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
JWT_SECRET=

# Habilite somente no primeiro início para criar a conta administrativa.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
